# Copy this file to .env.local and fill in real values. Never commit .env.local.

# AI assistant (Phase 8) — free key from https://aistudio.google.com
GEMINI_API_KEY=

# Project form emails (Phase 7) — https://resend.com
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Sender address on your verified Resend domain, e.g. "Studio <form@mydomain.de>"
CONTACT_FROM_EMAIL=

# Rate limiting for form + chat (Phase 7) — https://upstash.com (free Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
